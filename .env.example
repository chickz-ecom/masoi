# ---- Shared ----
NODE_ENV=development

# ---- Game server ----
# Local dev infra from docker-compose.dev.yml
DATABASE_URL=postgresql://masoi:masoi_dev_password@127.0.0.1:55432/masoi?schema=public
REDIS_URL=redis://127.0.0.1:56379
GAME_SERVER_PORT=4000
GAME_SERVER_HOST=0.0.0.0
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:3100
# Behind Nginx in production
TRUST_PROXY=false
LOG_LEVEL=info
# Session lifetime (days)
SESSION_TTL_DAYS=7

# ---- Web (Next.js) ----
# Leave empty in production (same origin via Nginx). In dev the browser talks to the game server directly.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000

# ---- Narration (VieNeu-TTS, optional) ----
# URL of a running VieNeu-TTS server (ElevenLabs-compatible). Empty = browser speech fallback.
TTS_URL=http://127.0.0.1:8000
TTS_VOICE="Hải Đăng"
# Only if the VieNeu server was started with VIENEU_API_KEY
TTS_API_KEY=
