# Copy thành /opt/masoi/.env.production trên VPS (chmod 600). Không commit file thật.
DOMAIN=masoi.example.com

# ---- PostgreSQL / Redis DÙNG CHUNG với Kestrel (mạng Docker ngoài `workspaces_shared`, docs/DEPLOY_VPS_SHARED.md) ----
# Alias do compose của Kestrel gắn cho kestrel-postgres-1 / kestrel-redis-1 trên mạng workspaces_shared.
MASOI_POSTGRES_HOST=shared-postgres
MASOI_REDIS_HOST=shared-redis
# Database và role cố định: `masoi` (role không superuser, chủ database masoi). Đây là mật khẩu của role masoi
# trên Postgres chung — đặt khi tạo role (openssl rand -hex 24), phải khớp với Postgres.
POSTGRES_PASSWORD=
# Redis: db 0, prefix "ww:" cố định trong compose.yml (Kestrel dùng "sa:"). Pool Postgres: connection_limit=10.
# shared (mặc định) | private = quay lại Postgres/Redis riêng cũ (compose.private-db.yml) — chỉ khi cần rollback.
MASOI_DB_MODE=shared
# Chỉ khi MASOI_DB_MODE=private và mật khẩu Postgres riêng cũ khác POSTGRES_PASSWORD:
# MASOI_PRIVATE_POSTGRES_PASSWORD=

# Cổng chỉ bind 127.0.0.1 — phải khớp với Caddyfile.masoi
MASOI_WEB_PORT=3100
MASOI_GAME_PORT=4100

LOG_LEVEL=info
SESSION_TTL_DAYS=7

# Để trống = dùng 62 câu dẫn đã thu sẵn bằng VieNeu giọng "Hải Đăng" (không cần VieNeu trên VPS).
# Chỉ đặt khi có VieNeu chạy trực tiếp và muốn đọc cả tên người chơi: TTS_URL=http://host.docker.internal:8000
TTS_URL=
TTS_VOICE="Hải Đăng"
TTS_API_KEY=
