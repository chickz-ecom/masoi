{
  "name": "masoi-online",
  "version": "0.1.0",
  "private": true,
  "description": "Ma Sói Online — multiplayer Werewolf web game (auto & human moderator modes)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/check-ports.mjs && npm run db:migrate && concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:server": "npm run dev -w @masoi/game-server",
    "dev:web": "npm run dev -w @masoi/web",
    "db:migrate": "npm run db:migrate -w @masoi/game-server",
    "db:seed": "npm run db:seed -w @masoi/game-server",
    "build": "npm run build -w @masoi/game-server && npm run build -w @masoi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @masoi/game-server",
    "format": "prettier --write .",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:with-infra": "npm run dev:infra && npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
